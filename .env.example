POSTGRES_DB=authtrace
POSTGRES_USER=authtrace
POSTGRES_PASSWORD=authtrace

AUTHTRACE_PUBLIC_HOST=127.0.0.1
AUTHTRACE_PUBLIC_PORT=8080
AUTHTRACE_DOCKER_LOG_MAX_SIZE=10m
AUTHTRACE_DOCKER_LOG_MAX_FILE=3
AUTHTRACE_APP_NAME=AuthTrace API
AUTHTRACE_ENV=production
AUTHTRACE_DEBUG=false
AUTHTRACE_API_V1_PREFIX=/api/v1
AUTHTRACE_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AUTHTRACE_DATABASE_URL=postgresql+psycopg://authtrace:authtrace@postgres:5432/authtrace
AUTHTRACE_TIMEZONE=UTC

AUTHTRACE_MANAGEMENT_SOURCE_KEY=main
AUTHTRACE_MANAGEMENT_SOURCE_NAME=默认管理端
AUTHTRACE_MANAGEMENT_SOURCE_DESCRIPTION=容器环境默认管理端
AUTHTRACE_MANAGEMENT_BASE_URL=
AUTHTRACE_MANAGEMENT_TOKEN=
AUTHTRACE_MANAGEMENT_TIMEOUT_SECONDS=30
AUTHTRACE_MANAGEMENT_REQUEST_RETRIES=2
AUTHTRACE_MANAGEMENT_RETRY_BACKOFF_SECONDS=1
AUTHTRACE_MANAGEMENT_PROBE_CONCURRENCY=1
AUTHTRACE_MANAGEMENT_PROBE_DELAY_MIN_SECONDS=0
AUTHTRACE_MANAGEMENT_PROBE_DELAY_MAX_SECONDS=0
AUTHTRACE_SCHEDULER_ENABLED=true
AUTHTRACE_SCHEDULER_INTERVAL_MINUTES=15
AUTHTRACE_SCHEDULER_JITTER_SECONDS=0
AUTHTRACE_MANAGEMENT_USER_AGENT=AuthTrace/0.1 (+https://local.authtrace)
AUTHTRACE_MANAGEMENT_TARGET_TYPE=
AUTHTRACE_MANAGEMENT_PROVIDER=
AUTHTRACE_MANAGEMENT_WEEKLY_QUOTA_THRESHOLD=95
AUTHTRACE_MANAGEMENT_SHORT_QUOTA_THRESHOLD=95
AUTHTRACE_DB_WAIT_ATTEMPTS=30
AUTHTRACE_DB_WAIT_INTERVAL_SECONDS=2
AUTHTRACE_BACKUP_DIR=backups
AUTHTRACE_DOCKER_COMMAND_TIMEOUT_SECONDS=120
